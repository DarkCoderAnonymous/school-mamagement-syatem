{
  "name": "@sms/backend",
  "version": "0.1.0",
  "private": true,
  "description": "School Management System backend (Express + TypeScript + Mongoose + MongoDB)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nodemon",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "seed:dummy-school": "tsx src/scripts/create-dummy-school.ts",
    "test": "jest --runInBand",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "backfill:permissions": "tsx src/scripts/backfill-role-permissions.ts",
    "migrate:memberships": "tsx src/scripts/migrate-to-memberships.ts",
    "test:cross-tenant": "jest --runInBand test/cross-tenant",
    "check:registry": "tsx scripts/check-registry-coverage.ts"
  },
  "dependencies": {
    "@sms/shared": "*",
    "argon2": "^0.41.1",
    "bullmq": "^6.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "rate-limit-redis": "^6.0.1",
    "slugify": "^1.6.9",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.1",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
