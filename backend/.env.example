# Server — NODE_ENV is required (development | test | production); there is no default.
NODE_ENV=development
PORT=4000

# MongoDB (replicaSet=rs0 required — Mongoose transactions need a replica set,
# see docker-compose.yml's mongo-init service which initiates it)
MONGO_URI=mongodb://sms:sms_dev_password@localhost:27017/sms_dev?authSource=admin&replicaSet=rs0

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_change_me
JWT_REFRESH_SECRET=change_me_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS (comma-separated list of allowed origins). Must be explicit in production — "*" is refused.
CORS_ORIGIN=http://localhost:3000

# Express trust proxy — must match the real proxy chain in front of the API:
# a hop count (1 = one load balancer/reverse proxy), true/false, or trusted
# addresses ("loopback, 10.0.0.0/8"). Wrong values make per-IP rate limits
# spoofable (too trusting) or lump every user into one IP (not trusting enough).
TRUST_PROXY=1

# Rate limiting
# Per-IP budget for sign-in, forgot/reset password (not refresh/me/logout).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Authenticated requests per user per minute, across the whole API.
API_RATE_LIMIT_MAX=600
# Bulk operations (reminder emails, invoice generation, reports, payroll runs) per user per minute.
HEAVY_RATE_LIMIT_MAX=30
# Public school applications per IP per hour (status checks: 6x this).
REGISTRATION_RATE_LIMIT_MAX=10

# Redis (BullMQ background jobs + login rate-limit store)
REDIS_URL=redis://localhost:6379

# Mail driver. "console" is the only one and delivers NO email: in development
# it prints each message (including reset tokens / temporary passwords) to the
# server console; in production it logs recipient + subject only. Production
# refuses to start unless this is set explicitly.
MAILER_DRIVER=console

# DEV ONLY: give every new account (invited staff, teachers, guardians, approved
# school admins) this temporary password instead of a random emailed one.
# They must still change it on first sign-in. Startup fails if set in production.
DEV_TEMP_PASSWORD=Welcome@123

# Seed scripts (npm run seed, seed:dummy-school) refuse any MONGO_URI that isn't
# localhost, because they wipe data and create known passwords. Set to 1 only
# to deliberately seed a remote NON-production database.
# SEED_ALLOW_REMOTE=1
