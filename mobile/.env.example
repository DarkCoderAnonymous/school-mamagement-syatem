# Base URL of the backend API.
# Must be prefixed with EXPO_PUBLIC_ to be inlined into the client bundle.
EXPO_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"

# Release builds refuse to start unless the API base URL is https:// (tokens and
# school records must never travel in cleartext). Set to 1 ONLY for a QA build
# pointed at a LAN server over http://; never for a store build. Development
# (expo start) is unaffected.
# EXPO_PUBLIC_ALLOW_INSECURE_API=1
